# docker-compose 变量模板
# 使用：cp .env.example .env
#   - docker-compose.yml 中 postgres/neo4j 的口令由本文件（compose 项目目录的 .env）注入；
#   - backend 服务容器的应用变量仍读取 backend/.env（见 docker-compose.yml 的 env_file）。
# 注意：POSTGRES_PASSWORD / NEO4J_PASSWORD 为 compose 强制必填（docker-compose.yml 用 ${VAR:?} 校验），
#       缺失时 docker compose 会直接报错并点出变量名，不会悄悄退回某个默认口令。

# —— docker-compose 基础设施口令（生产请改强随机值）——
POSTGRES_PASSWORD=change-me-strong-password
NEO4J_PASSWORD=change-me-strong-password

# —— 华为云 MaaS（大模型 / Embedding）——
MAAS_API_KEY=
MAAS_BASE_URL=
MAAS_MODEL=pangu

# —— 安全 ——
SECRET_KEY=change-me-in-production