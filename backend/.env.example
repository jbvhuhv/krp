PROJECT_NAME=Knowledge Reflection Platform
API_V1_PREFIX=/api/v1

# 调试开关：DEBUG=true 时启用开发态能力（如详细错误回显）
DEBUG=false
# 是否对外暴露 Swagger / ReDoc / OpenAPI。默认关闭：
# 演示环境常常 DEBUG=true，此时不单独控制的话 /docs 会把完整接口面公开到公网。
ENABLE_API_DOCS=false
# 弱 SECRET_KEY 的逃生阀，默认 false：密钥含 change-me/secret/demo/请替换 等字样
# 或短于 16 位时，应用会直接拒绝启动（与 DEBUG 无关，避免带着占位密钥上线）。
# 只有在本地开发确实无所谓时才设为 true，生产环境务必留空。
ALLOW_WEAK_SECRET=false
# 仅本地调试：允许万能验证码登录，生产必须保持 false
ALLOW_DEV_LOGIN=false

# 数据库连接串：留空则按下面的 POSTGRES_* 拼 PostgreSQL 连接串。
# 本地开发/一键体验建议保持为下面的 SQLite（开箱即用，无需额外起数据库）；
# 只有显式设置本项或删除本行之后，下面的 POSTGRES_* 才会生效。
POSTGRES_URL=sqlite+aiosqlite:///./krp.db

# PostgreSQL 连接参数（POSTGRES_URL 留空时使用）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# 生产环境务必改为强随机口令，并通过部署环境变量注入，切勿沿用默认值
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=krp

# 本地 Neo4j（Docker Compose 内网地址为 bolt://neo4j:7687，见 docker-compose.yml）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# 生产环境务必改为强随机口令
NEO4J_PASSWORD=change-me-strong-password

# Redis 可选；未配置时 /auth/send-code 返回 503
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 生产环境（DEBUG=false）必须配置强随机密钥，否则服务拒绝启动
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# AI 知识抽取 / 对话：优先读取 LLM_*，未配置时回退 MAAS_*
# LLM_PROVIDER 可选 maas / openai；注意 openai_provider 目前为预留空壳，会抛 NotImplementedError
LLM_PROVIDER=maas
LLM_API_KEY=
LLM_BASE_URL=
# 留空则回退使用 MAAS_MODEL；若填写，会被优先使用（此时 LLM_BASE_URL 必须同时填写）
LLM_MODEL=
# MAAS 端点（含 bge-m3 embedding，用于数字分身 RAG）
MAAS_API_KEY=
MAAS_BASE_URL=
# 请填写账号下有效的 MaaS 模型 ID
MAAS_MODEL=<your-maas-model-id>
MAAS_EMBEDDING_MODEL=bge-m3

# 图片笔记 OCR：填入一个支持视觉的 OpenAI 兼容多模态模型端点（如 GLM-4V / Qwen-VL / GPT-4o）
# base_url 不含 /v1，调用时会拼接 /v1/chat/completions
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=

EMBEDDING_DIMENSION=1024
NEO4J_VECTOR_INDEX=knowledge_node_embedding

AVATAR_SIMILARITY_THRESHOLD=0.7
AVATAR_TOP_K=5
AVATAR_EMBED_BACKFILL_LIMIT=200
SHARE_BASE_URL=http://localhost:5173

SCHEDULER_ENABLED=true
REFLECTION_CRON_HOUR=20
REFLECTION_CRON_MINUTE=0
REFLECTION_DAILY_LIMIT=5
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_BACKOFF_SECONDS=2.0

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ---------- 演示与部署开关 ----------
# 空库（或库中无用户数据）时自动灌入演示数据；关闭则启动后为空库
DEMO_BOOTSTRAP=true
# 图谱后端：auto（默认，Neo4j 可用则用 Neo4j，否则用内置只读演示图谱）/ sqlite / neo4j
GRAPH_BACKEND=auto
# 前端构建产物目录；留空则自动探测（../frontend/dist、./frontend_dist）
FRONTEND_DIST=

# ---------- 短信验证码 ----------
SMS_CODE_TTL=300
SMS_DAILY_LIMIT=5
SMS_RATE_LIMIT_INTERVAL=60
# 开发态万能验证码；需与 ALLOW_DEV_LOGIN=true 同时生效
SMS_DEV_MASTER_CODE=123456
# 万能码可登录的手机号白名单（英文逗号分隔）。留空 = 万能码对所有手机号都不生效。
# 不要留空的同时又开着 ALLOW_DEV_LOGIN：白名单为空等于该功能被禁用，登录会一直失败。
DEV_LOGIN_PHONE_ALLOWLIST=13900000001

# ---------- 其它 ----------
APP_VERSION=0.1.0
TIMEZONE_OFFSET_HOURS=8.0
AVATAR_KEYWORD_THRESHOLD=0.2
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
ALLOWED_EXTENSIONS=[".md", ".markdown", ".txt", ".pdf", ".doc", ".docx"]
IMAGE_EXTENSIONS=[".png", ".jpg", ".jpeg"]