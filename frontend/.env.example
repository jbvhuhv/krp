# 开发态登录预填（VITE_DEBUG_*）
# 仅当 Vite 运行在开发模式（import.meta.env.DEV = true）时生效，
# 生产构建 DEV=false，不会注入，也不会打包进产物。
# 使用方式：复制本文件为 .env.development.local 并按需填写；
#           *.local 已被 .gitignore 忽略，不会提交到仓库。
VITE_DEBUG_PHONE=
VITE_DEBUG_CODE=

# 开发服务器把 /api、/uploads、/health 代理到哪个后端。
# 后端换端口时改这里即可，不必动 vite.config.js。留空则用 http://localhost:8000。
VITE_API_TARGET=
