# ===== 生产环境配置模板（自建服务器部署用）=====
# 用法：复制为 .env.production，逐项填写后：
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# 注意：本文件是「模板」，真实 .env.production 已在 .gitignore 中排除，请勿提交。

# ---------- 安全（必填，务必改成随机值）----------
# 生成命令：openssl rand -hex 32
SECRET_KEY=请替换为随机字符串

# ---------- 数据库 ----------
# 关系库用 SQLite（容器内 /data 卷持久化），无需 Postgres
POSTGRES_URL=sqlite+aiosqlite:////data/krp.db

# ---------- 图谱（Neo4j 容器）----------
# 密码至少 8 位；用户名固定为 neo4j，连接地址由编排文件注入为 bolt://neo4j:7687
NEO4J_PASSWORD=请替换为强密码
# 图谱后端：auto（默认，Neo4j 可用则用 Neo4j，否则用内置只读演示图谱）
GRAPH_BACKEND=auto
# 前端构建产物目录（镜像内已放置，通常无需修改）
FRONTEND_DIST=/app/frontend_dist

# ---------- 运行模式（生产必须是 false）----------
# 调试模式：生产保持 false，避免内部异常细节外泄
DEBUG=false

# ---------- 演示开关 ----------
# 万能验证码登录：默认 false。
# 该能力必须同时满足 DEBUG=true + ALLOW_DEV_LOGIN=true + 显式设置 SMS_DEV_MASTER_CODE 才会生效；
# 仅在本地/临时演示环境使用，正式对外必须保持 false 并接入真实短信服务。
ALLOW_DEV_LOGIN=false
SMS_DEV_MASTER_CODE=
# 空库时自动灌入演示数据（32 篇笔记 / 12 个广场作品 / 719 节点图谱）
DEMO_BOOTSTRAP=true

# ---------- AI 能力（可选，但"上传笔记→自动抽取"必需）----------
# 文本抽取（LLM）：留空则上传的笔记无法抽取，仅能浏览演示数据
LLM_PROVIDER=maas
LLM_API_KEY=
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode
LLM_MODEL=qwen3.5-omni-flash-2026-03-15

# 图片笔记（多模态 OCR）：留空则不支持图片笔记
OCR_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode
OCR_API_KEY=
OCR_MODEL=qwen3.5-omni-flash-2026-03-15
