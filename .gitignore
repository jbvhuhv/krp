# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# 敏感配置（务必忽略，禁止提交密钥）
.env
*.env
backend/.env
!.env.example
# 生产部署配置：含 SECRET_KEY / Neo4j 密码，绝不提交（模板 .env.production.example 可提交）
.env.production
.env.*.local

# 本地数据库
*.db
*.sqlite3
# SQLite WAL 模式会产生这两个附属文件，之前没被 *.db 覆盖，git status 里一直是脏的
*.db-wal
*.db-shm
# 例外：随仓库分发的演示数据（已脱敏，供空库首次启动自动灌入）
!backend/demo/krp-demo.db

# 临时导出/调试脚本产物（评审期间生成的接口快照、健康检查结果等）
_openapi.json
_oa_check.json

# 日志
*.log

# 上传与构建产物
backend/uploads/
uploads/
frontend/dist/
node_modules/
frontend/node_modules/

# 第三方运行时依赖（仅根目录下本地下载的 Neo4j/JDK/Maven 等，体量大，不提交）
# 注意必须锚定根目录：写成 `deps/` 会匹配任意层级的 deps 目录，
# 从而把应用源码包 backend/app/api/deps/ 一起排除（曾导致克隆后无法启动）。
/deps/

# 运行时日志目录
logs/

# 工具/编辑器产物
.merkle-snapshot.json
.arts/
.codeartsdoer/
structure.txt
nul
.idea/
.vscode/
*.swp
.DS_Store

# 本地 AI 技能/工具（由 npx skills add 安装，非作品内容）
.agents/
skills-lock.json
